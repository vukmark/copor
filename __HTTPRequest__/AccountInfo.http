import login.http
run login.http

### GET Account Info
GET {{host}}/user/account-information/f99ce525-38bd-11f1-916b-df41a98aba05
Content-Type: application/json
Authorization: Bearer {{auth_token}}
x-Version: {{x-version}}

### UPDATE Personal Account info
PATCH {{host}}/user/account-information
Content-Type: application/json
Authorization: Bearer {{auth_token}}
x-Version: {{x-version}}

{
  "firstName": "Sasha",
  "lastName": "Militsch",
  "address": "Some Address 123",
  "postalCode": "79220",
  "city": "Maine",
  "country": "4e9932d6-5f6c-42d3-8f44-2b7683ba413d",
  "state": "2b2b2222-bbbb-4bbb-bbbb-2b2b2b2b2b2b",
  "email": "testmail@mail.com",
  "phoneNumberList": [
    {
      "id": "16f97f82-583c-41c8-abcf-134b6fb2a04b",
      "phoneNumber": "12321232123526",
      "phoneNumberType": "PHONE_MOBILE"
    },
    {
      "id": "",
      "phoneNumber": "234564345345345",
      "phoneNumberType": "PHONE_MOBILE"
    }
  ]
}

