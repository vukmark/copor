import login.http
run login.http

### Forgot Password - Send Code By Email
POST {{host}}/user/forgot-password/send-code
Content-Type: application/json
x-Version: {{x-version}}

{
  "userName": "super.admin"
}

### Forgot Password - Verify Reset Code
POST {{host}}/user/forgot-password/verify-code
Content-Type: application/json
x-Version: {{x-version}}

{
  "userName": "super.admin",
  "code": "576418"
}

### Forgot Password - Reset Password
POST {{host}}/user/forgot-password/reset-password
Content-Type: application/json
x-Version: {{x-version}}

{
  "userName": "super.admin",
  "code": "576418",
  "newPassword": "Testina123!"
}