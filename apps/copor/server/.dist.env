# Host the server binds to (default: localhost)
HOST_NAME=localhost
WEB_SOCKET_PORT=3002
# ping interval for websocket in ms
WEB_SOCKET_PING_INTERVAL=30000
# how long to wait (ms) after a user's last connection closes before broadcasting them as offline
WEB_SOCKET_OFFLINE_DEBOUNCE=6000
# This is returned to frontend when it asks for ws server
WEB_SOCKET_SERVER=ws://localhost:3002
# This is returned to frontend when it asks for jitsi server
JITSI_SERVER=https://meet.example.com
# This is node backend port
PORT=3000
NODE_ENV=development
# Key for generating jwt tokens
PRIVATE_KEY=secret
TOKEN_EXPIRE_TIME=700d
TOKEN_REFRESH_TIME=1000d
APPLICATION_TYPE=copor
# Frontend is sending its version in header. This is mimimum allowed version
MINIMUM_VERSION=1.0.0
# Firebase setup file
FIREBASE_ADMIN_KEY_FILE=firebase-adminsdk-key.json
# For testing in dev mode .ts After build .js
FILE_EXTENSION=.ts
# Logging of database queries. For testing 1. For production 0.
APP_DATA_SOURCE_LOGGING=0

## kysely|fake
DB_ENV=kysely
DB_HOST=localhost
DB_PORT=3306
DB_USER=developer
DB_PASS=developer
DB_NAME=copor
## Timeout for data source initialization
DATA_SOURCE_TIMEOUT=3000

## Image path for default user profile image
DEFAULT_USER_PROFILE_IMAGE=default.jpg
PROFILE_IMAGE_PATH=http://192.168.1.17:3000/assets/img/
IMAGE_PATH=http://192.168.1.17:3000/assets/img/
DEFAULT_USER_PROFILE_IMAGE_NAME=default
DEFAULT_USER_PROFILE_IMAGE_EXTENSION=jpg

## Image path for default group chat image
DEFAULT_GROUP_CHAT_IMAGE=default.jpg

## Password hashing salt rounds
PASSWORD_HASHING_SALT_ROUNDS=10

## Maximum media size for upload in MB
MAX_MEDIA_SIZE_MB=64
MAX_FILE_SIZE_MB=64
TODO_MAX_FILE_SIZE_MB=64
VU_MEET_MAX_FILE_SIZE_MB=64
CLOUD_MAX_FILE_SIZE_MB=64

##Image upload folder
IMAGE_UPLOAD_FOLDER=/home/developer/Projects/copor/apps/copor/server/assets/img/

## Absolute folder path where uploaded media files (Cloud, VuMeet, ...) are stored
MEDIA_FILES_FOLDER=/home/developer/Projects/copor/apps/copor/server/MediaFiles

## Absolute path of the assets folder (served at /assets/*, documents at /documents/*)
ASSETS_PATH_ON_SERVER=/home/developer/Projects/copor/apps/copor/server/assets/
# Extra debug logging (VerboseLog); anything but "false" turns it on
VERBOSE_LOGGING=false
