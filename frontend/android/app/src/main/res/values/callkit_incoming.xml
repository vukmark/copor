    <dimen name="base_margin_x2">20dp</dimen>
    <dimen name="base_margin_x2_5">25dp</dimen>
    <dimen name="base_margin_x3">30dp</dimen>
    <dimen name="base_margin_x3_5">35dp</dimen>
