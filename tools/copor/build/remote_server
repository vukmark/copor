#!/bin/bash

source $VUKMARK_PATH/tools/helpers/printer.sh
source $VUKMARK_PATH/tools/helpers/input_validators.sh

# Check if a configuration file path is provided
if [ "$#" -ne 2 ]; then
    print_error_how_to_set_remote_config
    exit 1
fi

source $1
VERSION_NUMBER=$2

exit_if_invalid_version $VERSION_NUMBER

ssh ${SSH_USER}@${HOST} "export VUKMARK_PATH=${REMOTE_VUKMARK_PATH}; source \$VUKMARK_PATH/tools/vukmark_env.sh; vuk build server ${VERSION_NUMBER} ${SERVER_NAME}"
