#!/bin/bash
# Creates the local database and its user from apps/copor/server/.env
# (DB_NAME, DB_USER, DB_PASS) and runs the migrations. The user gets rights on
# that database only. Needs a MySQL/MariaDB admin: `sudo mysql` by default,
# override with COPOR_DB_ADMIN (e.g. COPOR_DB_ADMIN="mysql -uroot -p").

source $COPOR_PATH/tools/helpers/printer.sh

ENV_FILE="$COPOR_PATH/apps/copor/server/.env"
MIGRATE=true
[ "$1" = "--no-migrate" ] && MIGRATE=false

if [ ! -f "$ENV_FILE" ]; then
	print_error "No $ENV_FILE yet — run 'copor setup env' first."
	exit 1
fi

DB_NAME=$(grep -E '^DB_NAME=' "$ENV_FILE" | cut -d= -f2-)
DB_USER=$(grep -E '^DB_USER=' "$ENV_FILE" | cut -d= -f2-)
DB_PASS=$(grep -E '^DB_PASS=' "$ENV_FILE" | cut -d= -f2-)
DB_HOST=$(grep -E '^DB_HOST=' "$ENV_FILE" | cut -d= -f2-)

for value in "$DB_NAME" "$DB_USER"; do
	if [[ ! "$value" =~ ^[A-Za-z0-9_]+$ ]]; then
		print_error "DB_NAME and DB_USER must be letters, digits and underscores (got '$value')."
		exit 1
	fi
done
if [ -z "$DB_PASS" ]; then
	print_error "DB_PASS is empty in $ENV_FILE."
	exit 1
fi
if [ -n "$DB_HOST" ] && [ "$DB_HOST" != "localhost" ] && [ "$DB_HOST" != "127.0.0.1" ]; then
	print_error "DB_HOST is '$DB_HOST': 'copor db create' only sets up a local database."
	exit 1
fi

ESCAPED_PASS=${DB_PASS//\\/\\\\}
ESCAPED_PASS=${ESCAPED_PASS//\'/\\\'}
SQL="CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER IF NOT EXISTS '$DB_USER'@'localhost' IDENTIFIED BY '$ESCAPED_PASS';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost';
FLUSH PRIVILEGES;"

print_info "Creating database '$DB_NAME' and user '$DB_USER'@'localhost' (rights on '$DB_NAME' only)..."
if ! echo "$SQL" | ${COPOR_DB_ADMIN:-sudo mysql}; then
	print_error "Could not run the SQL as a database admin. Ask an admin to run it, then 'copor db create' again:"
	echo "${SQL//$ESCAPED_PASS/<DB_PASS>}"
	exit 1
fi

if [ "$MIGRATE" = true ]; then
	print_info "Running migrations..."
	cd "$COPOR_PATH/apps/copor/server" && npm run db:migrate
fi
