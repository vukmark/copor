import {CreateCAMEL_CASE_NAMEReqBodyDTO} from './dto/CreateCAMEL_CASE_NAMEReqBodyDTO';
import {PermissionValidatorRepoPicker} from '@copor/core/client/Core/PermissionValidatorRepo/PermissionValidatorRepoPicker';
import {
	ValidateCreateCAMEL_CASE_NAMEDTO
} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/validation/dto/ValidateCreateCAMEL_CASE_NAMEDTO';
import {ValidateCreateCAMEL_CASE_NAME} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/validation/ValidateCreateCAMEL_CASE_NAME';
import {SaveCAMEL_CASE_NAMEDTO} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/interactor/dto/SaveCAMEL_CASE_NAMEDTO';
import {CreateCAMEL_CASE_NAMEInteractorRepoPicker} from './repo/repoPicker/CreateCAMEL_CASE_NAMEInteractorRepoPicker';
import {CreateCAMEL_CASE_NAME} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/interactor/CreateCAMEL_CASE_NAME';
import {CreateCAMEL_CASE_NAMELoggerRepoPicker} from './repo/repoPicker/CreateCAMEL_CASE_NAMELoggerRepoPicker';
import {
	LogCreateCAMEL_CASE_NAME,
	LogDataForCreateCAMEL_CASE_NAME
} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/logger/LogCreateCAMEL_CASE_NAME';
import {CreateLogDetails} from '@copor/core/client/GlobalRepository/CreateLogDetails';
import {Validator} from '@copor/core/domain/Core/Validations/Validators/Validator';
import {UseCase} from '@copor/core/domain/Core/Interactors/UseCase';
import {LogAction} from '@copor/core/domain/Core/Logger/LogAction';
import {CreateBaseController} from '@copor/core/client/Core/Controller/CreateBaseController';

export class CreateCAMEL_CASE_NAMEController extends CreateBaseController<CreateCAMEL_CASE_NAMEReqBodyDTO> {
	protected getValidator(): Validator {
		const container = this.container;
		const validatorPermissionRepo = container.getNewRepoPicker(PermissionValidatorRepoPicker);
		const validatorInput: ValidateCreateCAMEL_CASE_NAMEDTO = {
			... this.request.body,
			actorId: this.actorId
		};

		return container.getValidator(
			ValidateCreateCAMEL_CASE_NAME,
			validatorInput,
			validatorPermissionRepo,
			undefined
		);
	}

	protected getInteractor(uniqueId: string) : UseCase<string> {
		const container = this.container;
		const interactorInput: SaveCAMEL_CASE_NAMEDTO = {
			... this.request.body,
			actorId: this.actorId,
			id: uniqueId
		};
		const interactorRepo = container.getNewRepoPicker(CreateCAMEL_CASE_NAMEInteractorRepoPicker);

		return container.getInteractor(
			CreateCAMEL_CASE_NAME,
			interactorRepo,
			interactorInput
		);
	}

	protected getLogger(uniqueId: string) : LogAction {
		const container = this.container;
		const loggerRepo = container.getNewRepoPicker(CreateCAMEL_CASE_NAMELoggerRepoPicker);
		const logData = this.getLogData(uniqueId);

		return container.getLogger(
			LogCreateCAMEL_CASE_NAME,
			loggerRepo,
			new CreateLogDetails(this.actorId),
			logData
		);
	}

	private getLogData(uniqueId: string): LogDataForCreateCAMEL_CASE_NAME {
		return {
			... this.request.body,
			id: uniqueId
		};
	}
}
