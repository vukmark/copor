import {SaveItem} from '@copor/core/domain/Core/Repository/SaveItem';
import {SaveCAMEL_CASE_NAMEDTO} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/interactor/dto/SaveCAMEL_CASE_NAMEDTO';
import {db} from '@copor/core/client/AppDataSource';
import {TimestampHelper} from '@copor/core/client/Core/Helpers/TimestampHelper';

export class KyselyCreateCAMEL_CASE_NAMEInteractorRepo implements SaveItem<SaveCAMEL_CASE_NAMEDTO> {
	async save(saveDTO: SaveCAMEL_CASE_NAMEDTO): Promise<void> {
		await db
			.insertInto('LOWER_FIRST_CAMEL_CASE_NAME')
			.values({
				id: saveDTO.id,
				name: saveDTO.name,
				... TimestampHelper.getTimestampForCreate(saveDTO.actorId)
			})
			.execute();
	}
}
