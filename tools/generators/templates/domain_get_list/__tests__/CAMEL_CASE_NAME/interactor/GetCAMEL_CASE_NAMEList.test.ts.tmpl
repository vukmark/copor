import {ListItems} from '@copor/core/domain/Core/Repository/ListItems';
import {GetCAMEL_CASE_NAMEDTO} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/interactor/dto/GetCAMEL_CASE_NAMEDTO';
import {GetCAMEL_CASE_NAMEList} from '@copor/PACKAGE_NAME/domain/CAMEL_CASE_NAME/interactor/GetCAMEL_CASE_NAMEList';

describe('get Contract Type list interactor test', () => {
	const mockRepo: jest.Mocked<ListItems<GetCAMEL_CASE_NAMEDTO>> = {
		list: jest.fn()
	};
	const expectedResponse: GetCAMEL_CASE_NAMEDTO[] = [{
		id: 'id',
		name: 'name'
	}];
	const getCAMEL_CASE_NAMEList: GetCAMEL_CASE_NAMEList = new GetCAMEL_CASE_NAMEList([], mockRepo);

	it('Should list all Contract Type List', async () => {
		mockRepo.list.mockResolvedValue(expectedResponse);
		expect(await getCAMEL_CASE_NAMEList.execute()).toEqual(expectedResponse);
	});
});
