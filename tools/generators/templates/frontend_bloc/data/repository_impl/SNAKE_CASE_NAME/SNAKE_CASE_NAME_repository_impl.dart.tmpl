class CAMEL_CASE_NAMERepositoryImpl extends BaseRepository implements CAMEL_CASE_NAMERepository {
  final CAMEL_CASE_NAMERemoteDataSource remoteDataSource;
  final CAMEL_CASE_NAMELocalDataSource localDataSource;

  CAMEL_CASE_NAMERepositoryImpl({
    required this.remoteDataSource,
    required this.localDataSource,
    required super.errorHandler,
    required super.connectivityService,
  });
  
  @override
  Future<Either<Failure, Result<CAMEL_CASE_NAMEItemModel>>> getCAMEL_CASE_NAME() {
    return performOperationAndMapToResult<CAMEL_CASE_NAMEItemModel>(
        localOperation: () {
      return performLocalStorageOperation<CAMEL_CASE_NAMEItemModel>(
          localDataSource.getCAMEL_CASE_NAME);
    }, remoteOperation: () {
      return performNetworkOperation<CAMEL_CASE_NAMEItemModel>(() async {
        final model = await remoteDataSource.getCAMEL_CASE_NAME();
        await localDataSource.setCAMEL_CASE_NAME(model);
        return model;
      });
    });
  }

}

