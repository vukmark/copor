{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "ES2022.Intl"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@copor/ai_context_item/*": [
        "packages/ai_context_item/server/src/*"
      ],
      "@copor/calendar_entry/*": [
        "packages/calendar_entry/server/src/*"
      ],
      "@copor/checklist/*": [
        "packages/checklist/server/src/*"
      ],
      "@copor/cloud/*": [
        "packages/cloud/server/src/*"
      ],
      "@copor/contacts/*": [
        "packages/contacts/server/src/*"
      ],
      "@copor/core/*": [
        "packages/core/server/src/*"
      ],
      "@copor/help/*": [
        "packages/help/server/src/*"
      ],
      "@copor/news/*": [
        "packages/news/server/src/*"
      ],
      "@copor/todo/*": [
        "packages/todo/server/src/*"
      ],
      "@copor/vu_meet/*": [
        "packages/vu_meet/server/src/*"
      ]
    }
  }
}
